import { Button, CheckBox, HorizontalBox, LineEdit, ScrollView, Slider, TextEdit, VerticalBox } from "std-widgets.slint";

export struct OccupiedCellVisual {
    x: int,
    y: int,
    color: color,
}

export struct MapMarker {
    x: int,
    y: int,
    text: string,
    color: color,
    bg: color,
}

export struct BuildingBoundary {
    x: int,
    y: int,
    horizontal: bool,
}

export struct SimulationCycleItem {
    workshop: string,
    weapon: string,
    armoury: string,
    ticks: string,
    seconds: string,
    note: string,
}

export struct SimulationInfoLine {
    text: string,
}

component BuildingButton inherits Rectangle {
    in property <string> title;
    in property <string> building-id;
    in property <image> icon;
    in property <string> selected-id;
    in property <color> map-color;
    callback selected(string);

    min-height: 72px;
    max-height: 72px;
    border-width: 2px;
    border-radius: 8px;
    border-color: selected-id == building-id ? #3465d9 : #8a8a8a;
    background: selected-id == building-id ? #e9f0ff : #f7f7f7;

    HorizontalBox {
        padding: 8px;
        spacing: 8px;

        Image {
            width: 52px;
            height: 52px;
            source: root.icon;
            image-fit: contain;
        }

        Text {
            text: root.title;
            vertical-alignment: center;
            wrap: word-wrap;
        }

        Rectangle {
            width: 20px;
            height: 20px;
            border-width: 1px;
            border-color: #666666;
            border-radius: 3px;
            background: root.map-color;
        }
    }

    TouchArea {
        clicked => {
            root.selected(root.building-id);
        }
    }
}

component SimulationToggleButton inherits Rectangle {
    in property <string> title;
    in property <string> weapon-name;
    in property <image> icon;
    callback pressed();

    height: 50px;
    horizontal-stretch: 1;
    border-width: 1px;
    border-color: #cfd6df;
    border-radius: 8px;
    background: #ffffff;
    clip: true;

    Text {
        x: 12px;
        y: 8px;
        width: parent.width - 58px;
        height: 16px;
        text: root.title;
        font-weight: 600;
        font-size: 12px;
        color: #1f2937;
        overflow: elide;
        vertical-alignment: center;
    }

    Text {
        x: 12px;
        y: 27px;
        width: parent.width - 58px;
        height: 14px;
        text: root.weapon-name;
        color: #6b7280;
        font-size: 10px;
        overflow: elide;
        vertical-alignment: center;
    }

    Rectangle {
        x: parent.width - 40px;
        y: 10px;
        width: 30px;
        height: 30px;
        border-width: 1px;
        border-color: #d8dde5;
        border-radius: 6px;
        background: #f8fafc;

        Image {
            x: 2px;
            y: 2px;
            width: 26px;
            height: 26px;
            source: root.icon;
            image-fit: contain;
        }
    }

    TouchArea {
        clicked => {
            root.pressed();
        }
    }
}

component PrimaryActionButton inherits Rectangle {
    in property <string> title;
    in property <bool> attention: false;
    callback pressed();

    min-width: 150px;
    height: 34px;
    border-width: 1px;
    border-color: root.attention ? #991b1b : #1f5fa8;
    border-radius: 6px;
    background: root.attention ? #dc2626 : #256fb8;

    Text {
        width: 100%;
        height: 100%;
        text: root.title;
        color: #ffffff;
        font-size: 13px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => {
            root.pressed();
        }
    }
}

component BuyResourceToggle inherits Rectangle {
    in property <string> title;
    in property <image> icon;
    in property <bool> checked;
    callback changed(bool);

    height: 42px;
    horizontal-stretch: 1;
    border-width: 1px;
    border-color: root.checked ? #2f6fb2 : #cfd6df;
    border-radius: 7px;
    background: root.checked ? #edf5ff : #ffffff;

    Rectangle {
        x: 10px;
        y: 12px;
        width: 18px;
        height: 18px;
        border-width: 1px;
        border-color: root.checked ? #1f6db5 : #9aa3af;
        border-radius: 3px;
        background: root.checked ? #1f75c1 : #ffffff;

        Text {
            width: 100%;
            height: 100%;
            text: root.checked ? "x" : "";
            color: #ffffff;
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Image {
        x: 38px;
        y: 7px;
        width: 28px;
        height: 28px;
        source: root.icon;
        image-fit: contain;
    }

    Text {
        x: 74px;
        y: 0px;
        width: parent.width - 84px;
        height: 100%;
        text: root.title;
        color: #1f2937;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }

    TouchArea {
        clicked => {
            root.changed(!root.checked);
        }
    }
}

component SteppedPopularitySlider inherits Rectangle {
    in property <[string]> stop-labels;
    in property <float> selected-index;
    in property <bool> control-enabled: true;
    callback selected(float);

    min-height: 52px;
    max-height: 52px;
    background: transparent;
    opacity: root.control-enabled ? 1 : 0.42;

    private property <length> rail-padding: 10px;
    private property <length> rail-width: max(1px, root.width - root.rail-padding * 2);
    private property <float> maximum-index: max(1, root.stop-labels.length - 1);
    private property <float> live-index: root.selected-index;
    private property <bool> dragging: false;

    changed selected-index => {
        if (!root.dragging) {
            root.live-index = root.selected-index;
        }
    }

    function update-live-index(mouse-x: length) {
        root.live-index = min(
            root.maximum-index,
            max(0, (mouse-x - root.rail-padding) / root.rail-width * root.maximum-index),
        );
    }

    function commit-nearest-stop() {
        root.live-index = round(root.live-index);
        root.dragging = false;
        root.selected(root.live-index);
    }

    Rectangle {
        x: root.rail-padding;
        y: 11px;
        width: root.rail-width;
        height: 4px;
        border-radius: 2px;
        background: #9ca3af;
    }

    Rectangle {
        x: root.rail-padding;
        y: 11px;
        width: root.rail-width * root.live-index / root.maximum-index;
        height: 4px;
        border-radius: 2px;
        background: #1473c9;
    }

    for label[index] in root.stop-labels: Rectangle {
        x: root.rail-padding + root.rail-width * index / root.maximum-index - 2px;
        y: 7px;
        width: 4px;
        height: 12px;
        border-radius: 2px;
        background: index <= round(root.live-index) ? #1473c9 : #6b7280;

        Text {
            x: index == 0 ? -3px : (index == root.stop-labels.length - 1 ? 7px - self.width : 2px - self.width / 2);
            y: 18px;
            width: max(28px, root.rail-width / root.stop-labels.length);
            height: 18px;
            text: label;
            color: index == round(root.live-index) ? #0f5fa8 : #64748b;
            font-size: root.stop-labels.length > 8 ? 9px : 10px;
            font-weight: index == round(root.live-index) ? 700 : 400;
            horizontal-alignment: index == 0 ? left : (index == root.stop-labels.length - 1 ? right : center);
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: root.rail-padding + root.rail-width * root.live-index / root.maximum-index - 8px;
        y: 5px;
        width: 16px;
        height: 16px;
        border-width: 2px;
        border-color: #ffffff;
        border-radius: 8px;
        background: #1473c9;
        drop-shadow-blur: 3px;
        drop-shadow-color: #66000000;
        drop-shadow-offset-y: 1px;
    }

    TouchArea {
        enabled: root.control-enabled;
        width: 100%;
        height: 34px;

        pointer-event(event) => {
            if event.button != PointerEventButton.left {
                return;
            }

            if event.kind == PointerEventKind.down {
                root.dragging = true;
                root.update-live-index(self.mouse-x);
            } else if event.kind == PointerEventKind.up && root.dragging {
                root.update-live-index(self.mouse-x);
                root.commit-nearest-stop();
            }
        }

        moved => {
            if root.dragging {
                root.update-live-index(self.mouse-x);
            }
        }
    }
}

component NumberSetting inherits Rectangle {
    in property <string> title;
    in property <int> value;
    in property <bool> control-enabled: true;
    callback submitted(string);

    min-height: 34px;
    max-height: 34px;
    border-width: 1px;
    border-color: #d3d9e2;
    border-radius: 6px;
    background: #fbfcfe;

    Text {
        x: 10px;
        y: 0px;
        width: parent.width - 112px;
        height: 100%;
        text: root.title;
        color: root.control-enabled ? #374151 : #9ca3af;
        font-size: 11px;
        vertical-alignment: center;
        overflow: elide;
    }

    LineEdit {
        enabled: root.control-enabled;
        x: parent.width - 98px;
        y: 4px;
        width: 88px;
        height: 26px;
        text: "" + root.value;
        accepted => { root.submitted(self.text); }
    }
}

component ToolButton inherits Rectangle {
    in property <string> title;
    in property <string> tool-id;
    in property <string> selected-id;
    in property <color> map-color;
    in property <image> icon;
    in property <bool> use-icon: false;
    in property <bool> show-color-mark: true;
    in property <bool> show-line-icon: true;
    callback selected(string);

    min-height: 56px;
    max-height: 56px;
    border-width: 2px;
    border-radius: 8px;
    border-color: selected-id == tool-id ? #3465d9 : #8a8a8a;
    background: selected-id == tool-id ? #e9f0ff : #f7f7f7;

    HorizontalBox {
        padding: 8px;
        spacing: 8px;

        Rectangle {
            width: 52px;
            height: 28px;
            border-width: 1px;
            border-color: #666666;
            border-radius: 4px;
            background: #ffffff;
            visible: !root.use-icon;

            Rectangle {
                x: 6px;
                y: 13px;
                width: 40px;
                height: 2px;
                background: root.map-color;
                visible: root.show-line-icon;
            }
        }

        Image {
            width: 52px;
            height: 28px;
            source: root.icon;
            image-fit: contain;
            visible: root.use-icon;
        }

        Text {
            text: root.title;
            vertical-alignment: center;
            wrap: word-wrap;
        }

        Rectangle {
            width: 20px;
            height: 20px;
            border-width: 1px;
            border-color: #666666;
            border-radius: 3px;
            background: root.map-color;
            visible: root.show-color-mark;
        }
    }

    TouchArea {
        clicked => {
            root.selected(root.tool-id);
        }
    }
}

export component MainWindow inherits Window {
    preferred-width: 1360px;
    preferred-height: 940px;
    min-width: 1360px;
    min-height: 820px;
    title: "SHC Eco Simulator - " + root.current-project-name;

    in property <int> map-min-x: 0;
    in property <int> map-min-y: 0;
    in property <int> map-max-x: 100;
    in property <int> map-max-y: 100;
    in property <int> map-width: 100;
    in property <int> map-height: 100;
    in-out property <length> canvas-pan-x: 0px;
    in-out property <length> canvas-pan-y: 0px;
    in-out property <float> zoom: 1.0;
    in-out property <string> selected-building: "";
    in-out property <string> status-text: "Ready";
    in property <[OccupiedCellVisual]> occupied-cells;
    in property <[OccupiedCellVisual]> preview-cells;
    in property <[OccupiedCellVisual]> no-entry-cells;
    in property <[BuildingBoundary]> building-boundaries;
    in property <[MapMarker]> anchor-labels;
    in property <[MapMarker]> entry-labels;
    in property <[MapMarker]> resource-labels;
    in property <[SimulationCycleItem]> simulation-cycles;
    in property <string> simulation-info-title: "";
    in property <string> simulation-info-subtitle: "";
    in property <[SimulationInfoLine]> simulation-info-lines;
    in-out property <bool> simulation-tooltips-enabled: true;
    in-out property <bool> simulation-tooltip-visible: false;
    in-out property <int> simulation-tooltip-x: 0;
    in-out property <int> simulation-tooltip-y: 0;
    in-out property <int> simulation-tooltip-height: 80;
    in-out property <bool> show-entry-points: true;
    in-out property <bool> optimize-fletcher-routing: false;
    in-out property <int> game-speed: 50;
    in-out property <int> fear-factor: 0;
    in-out property <bool> buy-wood: true;
    in-out property <bool> buy-iron: true;
    in-out property <bool> buy-wheat: false;
    in-out property <bool> buy-flour: false;
    in property <string> eco-setup-cost: "Eco setup cost: 0 gold";
    in property <string> workshop-count-summary: "";
    in property <string> bread-count-summary: "";
    in property <string> armoury-summary: "Armoury production\nNo armoury placed";
    in-out property <string> fletchers-weapon: "bow";
    in-out property <string> poleturners-weapon: "spear";
    in-out property <string> blacksmiths-weapon: "sword";
    in property <string> current-project-name: "Untitled";
    in property <string> recent-project-name: "";
    private property <int> active-workspace: 0;
    in-out property <bool> population-economy-enabled: false;
    in property <bool> simulation-results-stale: true;
    in property <int> population-max: 500;
    in property <int> population-current: 0;
    in property <int> population-workers: 0;
    in property <int> inn-count: 0;
    in property <int> stone-quarry-count: 0;
    in property <int> iron-mine-count: 0;
    in property <int> tax-index: 3;
    in property <int> food-ratio-index: 2;
    in property <string> tax-label: "";
    in property <string> food-ratio-label: "";
    in property <int> total-popularity: 0;
    in property <bool> popularity-good: true;
    in property <string> population-worker-summary: "";
    in property <string> population-economy-summary: "";

    callback place-at(float, float);
    callback hover-at(float, float);
    callback select-building(string);
    callback clear-selection();
    callback adjust-zoom(float);
    callback remove-all();
    callback remove-all-walls();
    callback undo();
    callback redo();
    callback set-optimize-fletcher-routing(bool);
    callback set-game-speed(float);
    callback set-fear-factor(float);
    callback set-buy-wood(bool);
    callback set-buy-iron(bool);
    callback set-buy-wheat(bool);
    callback set-buy-flour(bool);
    callback run-simulation();
    callback set-simulation-tooltips-enabled(bool);
    callback toggle-fletchers-weapon();
    callback toggle-poleturners-weapon();
    callback toggle-blacksmiths-weapon();
    callback open-project();
    callback open-recent-project();
    callback save-project();
    callback save-project-as();
    callback set-population(float);
    callback set-population-economy-enabled(bool);
    callback set-max-population(string);
    callback set-inn-count(string);
    callback set-stone-quarry-count(string);
    callback set-iron-mine-count(string);
    callback set-tax-index(float);
    callback set-food-ratio-index(float);

    private property <length> cell-px: 10px * root.zoom;
    private property <length> map-width-px: root.map-width * root.cell-px;
    private property <length> map-height-px: root.map-height * root.cell-px;
    private property <int> grid-x-count: root.map-width + 1;
    private property <int> grid-y-count: root.map-height + 1;

    private property <length> outer-padding: 12px;
    private property <length> panel-gap: 12px;
    private property <length> assets-panel-width: 250px;
    private property <length> info-panel-width: 360px;
    private property <length> map-panel-width: 700px;
    private property <length> map-frame-width: root.map-panel-width - 20px;
    private property <length> map-frame-height: 430px;
    private property <length> workspace-top: 12px;

    init => { content-scope.focus(); }

    MenuBar {
        Menu {
            title: "File";

            MenuItem {
                title: "Open…";
                shortcut: @keys(Control + O);
                activated => { root.open-project(); }
            }

            MenuItem {
                title: "Open Recent";
                enabled: root.recent-project-name != "";
                activated => { root.open-recent-project(); }
            }

            MenuItem {
                title: "Save";
                shortcut: @keys(Control + S);
                activated => { root.save-project(); }
            }

            MenuItem {
                title: "Save As…";
                shortcut: @keys(Control + Shift + S);
                activated => { root.save-project-as(); }
            }
        }

        Menu {
            title: "Edit";

            MenuItem {
                title: "Undo";
                shortcut: @keys(Control + Z);
                activated => { root.undo(); }
            }

            MenuItem {
                title: "Redo";
                shortcut: @keys(Control + Y);
                activated => { root.redo(); }
            }
        }
    }

    content-scope := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: false;

        Rectangle {
            x: root.outer-padding;
            y: 8px;
            width: root.width - (root.outer-padding * 2);
            height: 42px;
            visible: false;
            background: transparent;

            HorizontalBox {
                spacing: 8px;

                Button {
                    text: root.active-workspace == 0 ? "● Layout Simulator" : "Layout Simulator";
                    clicked => { root.active-workspace = 0; }
                }

                Button {
                    text: root.active-workspace == 1 ? "● Population & Economy" : "Population & Economy";
                    clicked => { root.active-workspace = 1; }
                }

                Rectangle { horizontal-stretch: 1; background: transparent; }
            }
        }

        assets-panel := Rectangle {
        x: root.outer-padding;
        y: root.workspace-top;
        width: root.assets-panel-width;
        height: root.height - root.workspace-top - root.outer-padding;
        visible: root.active-workspace == 0;
        border-width: 1px;
        border-color: #c5c5c5;
        border-radius: 8px;
        background: #ffffff;
        clip: true;

        VerticalBox {
            padding: 10px;
            spacing: 8px;

            Rectangle {
                border-width: 1px;
                border-color: #d9d9d9;
                border-radius: 6px;
                background: #fafafa;
                min-height: 296px;
                max-height: 296px;

                VerticalBox {
                    padding: 8px;
                    spacing: 8px;

                    Text {
                        text: "Assign Stockpile Resource";
                        min-height: 24px;
                        max-height: 24px;
                        font-size: 15px;
                        font-weight: 700;
                        color: #1f2937;
                        vertical-alignment: center;
                    }

                    ToolButton {
                        title: "Wood";
                        tool-id: "set_wood_stock";
                        selected-id: root.selected-building;
                        map-color: #c4965c;
                        icon: @image-url("../assets/wood.png");
                        use-icon: true;
                        show-color-mark: false;
                        selected(id) => { root.select-building(id); }
                    }

                    ToolButton {
                        title: "Iron";
                        tool-id: "set_iron_stock";
                        selected-id: root.selected-building;
                        map-color: #aaaab2;
                        icon: @image-url("../assets/iron.png");
                        use-icon: true;
                        show-color-mark: false;
                        selected(id) => { root.select-building(id); }
                    }

                    ToolButton {
                        title: "Wheat";
                        tool-id: "set_wheat_stock";
                        selected-id: root.selected-building;
                        map-color: #d4b849;
                        icon: @image-url("../assets/goods/wheat.png");
                        use-icon: true;
                        show-color-mark: false;
                        selected(id) => { root.select-building(id); }
                    }

                    ToolButton {
                        title: "Flour";
                        tool-id: "set_flour_stock";
                        selected-id: root.selected-building;
                        map-color: #e8e0c4;
                        icon: @image-url("../assets/goods/flour.png");
                        use-icon: true;
                        show-color-mark: false;
                        selected(id) => { root.select-building(id); }
                    }
                }
            }

            Text {
                text: "Buildings";
                font-size: 18px;
                font-weight: 600;
            }

            ScrollView {
                width: 100%;
                vertical-stretch: 1;

                VerticalBox {
                    width: 100%;
                    spacing: 8px;

                    BuildingButton {
                        title: "Goods Yard";
                        building-id: "goods_yard";
                        selected-id: root.selected-building;
                        icon: @image-url("../assets/Goods_Yard.png");
                        map-color: #b3784e;
                        selected(id) => { root.select-building(id); }
                    }

                    BuildingButton {
                        title: "Armoury";
                        building-id: "armoury";
                        selected-id: root.selected-building;
                        icon: @image-url("../assets/Armoury.png");
                        map-color: #6786ab;
                        selected(id) => { root.select-building(id); }
                    }

                    BuildingButton {
                        title: "Fletchers Workshop";
                        building-id: "fletchers_workshop";
                        selected-id: root.selected-building;
                        icon: @image-url("../assets/Fletchers_Workshop.png");
                        map-color: #529c5e;
                        selected(id) => { root.select-building(id); }
                    }

                    BuildingButton {
                        title: "Blacksmiths Workshop";
                        building-id: "blacksmiths_workshop";
                        selected-id: root.selected-building;
                        icon: @image-url("../assets/Blacksmiths_Workshop.png");
                        map-color: #4a4a4a;
                        selected(id) => { root.select-building(id); }
                    }

                    BuildingButton {
                        title: "Poleturners Workshop";
                        building-id: "poleturners_workshop";
                        selected-id: root.selected-building;
                        icon: @image-url("../assets/Poleturners_Workshop.png");
                        map-color: #af9156;
                        selected(id) => { root.select-building(id); }
                    }

                    BuildingButton {
                        title: "Armourers Workshop";
                        building-id: "armourers_workshop";
                        selected-id: root.selected-building;
                        icon: @image-url("../assets/Armourers_Workshop.png");
                        map-color: #976fab;
                        selected(id) => { root.select-building(id); }
                    }

                    BuildingButton {
                        title: "Wheat Farm";
                        building-id: "wheat_farm";
                        selected-id: root.selected-building;
                        icon: @image-url("../assets/ST30_Wheatfarm.png");
                        map-color: #c2ae4c;
                        selected(id) => { root.select-building(id); }
                    }

                    BuildingButton {
                        title: "Wind Mill";
                        building-id: "windmill";
                        selected-id: root.selected-building;
                        icon: @image-url("../assets/ST34_Mill.png");
                        map-color: #a49b8a;
                        selected(id) => { root.select-building(id); }
                    }

                    BuildingButton {
                        title: "Bakery";
                        building-id: "bakery";
                        selected-id: root.selected-building;
                        icon: @image-url("../assets/ST17_Bakers_Workshop.png");
                        map-color: #be7742;
                        selected(id) => { root.select-building(id); }
                    }

                    BuildingButton {
                        title: "Granary";
                        building-id: "granary";
                        selected-id: root.selected-building;
                        icon: @image-url("../assets/ST19_Granary.png");
                        map-color: #895c3a;
                        selected(id) => { root.select-building(id); }
                    }

                    ToolButton {
                        title: "Wall";
                        tool-id: "wall";
                        selected-id: root.selected-building;
                        map-color: #78543e;
                        selected(id) => { root.select-building(id); }
                    }

                }
            }
        }
    }

    map-panel := Rectangle {
        x: assets-panel.x + assets-panel.width + root.panel-gap;
        y: root.workspace-top;
        width: root.map-panel-width;
        height: root.height - root.workspace-top - root.outer-padding;
        visible: root.active-workspace == 0;
        border-width: 1px;
        border-color: #c5c5c5;
        border-radius: 8px;
        background: #ffffff;
        clip: true;

        VerticalBox {
            padding: 10px;
            spacing: 8px;

            Rectangle {
                min-height: 42px;
                max-height: 42px;
                background: transparent;
                clip: true;

                Button {
                    x: 0px;
                    y: 4px;
                    width: 34px;
                    height: 34px;
                    text: "-";
                    clicked => { root.adjust-zoom(-0.1); }
                }

                Button {
                    x: 40px;
                    y: 4px;
                    width: 34px;
                    height: 34px;
                    text: "+";
                    clicked => { root.adjust-zoom(0.1); }
                }

                Text {
                    x: 82px;
                    y: 0px;
                    width: 76px;
                    height: 42px;
                    vertical-alignment: center;
                    text: "Zoom: " + (root.zoom * 100) + "%";
                }

                Button {
                    x: 166px;
                    y: 4px;
                    width: 74px;
                    height: 34px;
                    text: "Remove";
                    clicked => {
                        canvas-key-scope.focus();
                        root.select-building("remove");
                    }
                }

                Button {
                    x: 248px;
                    y: 4px;
                    width: 118px;
                    height: 34px;
                    text: "Remove All Walls";
                    clicked => {
                        canvas-key-scope.focus();
                        root.remove-all-walls();
                    }
                }

                Button {
                    x: 374px;
                    y: 4px;
                    width: 90px;
                    height: 34px;
                    text: "Remove All";
                    clicked => {
                        canvas-key-scope.focus();
                        root.remove-all();
                    }
                }

                Text {
                    x: parent.width - 170px;
                    y: 0px;
                    width: 160px;
                    height: 42px;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    color: #475569;
                    font-size: 11px;
                    overflow: elide;
                    text: "X " + root.map-min-x + ".." + (root.map-max-x - 1)
                        + "   Y " + root.map-min-y + ".." + (root.map-max-y - 1);
                }
            }

            HorizontalBox {
                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                Rectangle {
                    width: root.map-frame-width;
                    height: root.map-frame-height;
                    border-width: 1px;
                    border-color: #dde3ea;
                    border-radius: 8px;
                    background: #f2f4f6;

                    canvas-key-scope := FocusScope {
                        width: 100%;
                        height: 100%;
                        focus-on-click: false;

                        capture-key-pressed(event) => {
                            if event.modifiers.control && (event.text == "z" || event.text == "Z") {
                                root.undo();
                                return accept;
                            }
                            if event.modifiers.control && (event.text == "y" || event.text == "Y") {
                                root.redo();
                                return accept;
                            }
                            return reject;
                        }

                        map-scroll := ScrollView {
                        width: 100%;
                        height: 100%;
                        viewport-width: root.map-width-px;
                        viewport-height: root.map-height-px;
                        viewport-x <=> root.canvas-pan-x;
                        viewport-y <=> root.canvas-pan-y;
                        mouse-drag-pan-enabled: false;

                        Rectangle {
                            width: root.map-width-px;
                            height: root.map-height-px;
                            background: #f8f8f8;

                            for x in root.grid-x-count: Rectangle {
                                x: x * root.cell-px;
                                y: 0px;
                                width: 1px;
                                height: root.map-height-px;
                                background: #d8d8d8;
                            }

                            for y in root.grid-y-count: Rectangle {
                                x: 0px;
                                y: y * root.cell-px;
                                width: root.map-width-px;
                                height: 1px;
                                background: #d8d8d8;
                            }

                            for cell in root.occupied-cells: Rectangle {
                                x: (cell.x - root.map-min-x) * root.cell-px;
                                y: (root.map-max-y - cell.y - 1) * root.cell-px;
                                width: max(1px, root.cell-px - 1px);
                                height: max(1px, root.cell-px - 1px);
                                background: cell.color;
                            }

                            for cell in root.preview-cells: Rectangle {
                                x: (cell.x - root.map-min-x) * root.cell-px;
                                y: (root.map-max-y - cell.y - 1) * root.cell-px;
                                width: max(1px, root.cell-px - 1px);
                                height: max(1px, root.cell-px - 1px);
                                background: cell.color;
                            }

                            for boundary in root.building-boundaries: Rectangle {
                                property <length> line-width: max(1px, root.cell-px / 6);
                                x: boundary.horizontal
                                    ? (boundary.x - root.map-min-x) * root.cell-px
                                    : (boundary.x - root.map-min-x) * root.cell-px - (self.line-width / 2);
                                y: boundary.horizontal
                                    ? (root.map-max-y - boundary.y) * root.cell-px - (self.line-width / 2)
                                    : (root.map-max-y - boundary.y - 1) * root.cell-px;
                                width: boundary.horizontal ? root.cell-px : self.line-width;
                                height: boundary.horizontal ? self.line-width : root.cell-px;
                                background: #111111;
                            }

                            for label in root.anchor-labels: Text {
                                x: (label.x - root.map-min-x) * root.cell-px + 1px;
                                y: (root.map-max-y - label.y - 1) * root.cell-px + max(0px, root.cell-px - 11px);
                                text: label.text;
                                color: label.color;
                                font-size: 10px;
                            }

                            for label in root.entry-labels: Rectangle {
                                x: (label.x - root.map-min-x) * root.cell-px;
                                y: (root.map-max-y - label.y - 1) * root.cell-px;
                                width: max(1px, root.cell-px - 1px);
                                height: max(1px, root.cell-px - 1px);
                                background: label.bg;
                                visible: root.show-entry-points;

                                Text {
                                    x: 1px;
                                    y: max(0px, root.cell-px - 11px);
                                    text: label.text;
                                    color: label.color;
                                    font-size: 10px;
                                }
                            }

                            for label in root.resource-labels: Rectangle {
                                x: (label.x - root.map-min-x) * root.cell-px;
                                y: (root.map-max-y - label.y - 1) * root.cell-px;
                                width: max(1px, root.cell-px - 1px);
                                height: max(1px, root.cell-px - 1px);
                                background: label.bg;

                                Text {
                                    x: 1px;
                                    y: max(0px, root.cell-px - 11px);
                                    text: label.text;
                                    color: label.color;
                                    font-size: 10px;
                                }
                            }

                            for cell in root.no-entry-cells: Rectangle {
                                x: (cell.x - root.map-min-x) * root.cell-px;
                                y: (root.map-max-y - cell.y - 1) * root.cell-px;
                                width: max(1px, root.cell-px - 1px);
                                height: max(1px, root.cell-px - 1px);
                                background: cell.color;
                            }

                        }
                    }

                    TouchArea {
                        width: 100%;
                        height: 100%;

                        property <length> start-mouse-x: 0px;
                        property <length> start-mouse-y: 0px;
                        property <length> start-viewport-x: 0px;
                        property <length> start-viewport-y: 0px;
                        property <bool> was-dragging: false;
                        property <bool> pan-active: false;

                        moved => {
                            if self.pan-active {
                                let dx = self.mouse-x - self.start-mouse-x;
                                let dy = self.mouse-y - self.start-mouse-y;

                                if abs(dx) > 3px || abs(dy) > 3px {
                                    self.was-dragging = true;
                                }

                                map-scroll.viewport-x = min(
                                    0px,
                                    max(
                                        map-scroll.visible-width - root.map-width-px,
                                        self.start-viewport-x + dx,
                                    ),
                                );
                                map-scroll.viewport-y = min(
                                    0px,
                                    max(
                                        map-scroll.visible-height - root.map-height-px,
                                        self.start-viewport-y + dy,
                                    ),
                                );
                            }
                        }

                        pointer-event(event) => {
                            if event.kind == PointerEventKind.move && !self.pan-active {
                                root.hover-at(
                                    root.map-min-x + (self.mouse-x - map-scroll.viewport-x) / root.cell-px,
                                    root.map-max-y - (self.mouse-y - map-scroll.viewport-y) / root.cell-px,
                                );
                            }

                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                canvas-key-scope.focus();
                                self.start-mouse-x = self.mouse-x;
                                self.start-mouse-y = self.mouse-y;
                                self.start-viewport-x = map-scroll.viewport-x;
                                self.start-viewport-y = map-scroll.viewport-y;
                                self.was-dragging = false;
                                self.pan-active = true;
                            }

                            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                                if !self.was-dragging {
                                    root.place-at(
                                        root.map-min-x + (self.mouse-x - map-scroll.viewport-x) / root.cell-px,
                                        root.map-max-y - (self.mouse-y - map-scroll.viewport-y) / root.cell-px,
                                    );
                                }
                                self.pan-active = false;
                            }

                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                                root.clear-selection();
                            }
                        }

                        scroll-event(event) => {
                            if event.delta-y > 0 {
                                root.adjust-zoom(0.1);
                                return accept;
                            }

                            if event.delta-y < 0 {
                                root.adjust-zoom(-0.1);
                                return accept;
                            }

                            reject
                        }
                    }

                    tooltip := Rectangle {
                        visible: root.simulation-tooltip-visible;
                        x: min(
                            parent.width - self.width - 10px,
                            max(10px, root.simulation-tooltip-x * 1px),
                        );
                        y: min(
                            parent.height - self.height - 10px,
                            max(10px, root.simulation-tooltip-y * 1px),
                        );
                        width: 250px;
                        height: root.simulation-tooltip-height * 1px;
                        border-width: 1px;
                        border-color: #88cfd6df;
                        border-radius: 0px;
                        background: #b3fffdf5;

                        VerticalBox {
                            padding: 10px;
                            spacing: 3px;

                            Text {
                                text: root.simulation-info-title;
                                font-weight: 700;
                                color: #1f2937;
                                wrap: word-wrap;
                            }

                            Text {
                                text: root.simulation-info-subtitle;
                                color: #5f6b7b;
                                visible: root.simulation-info-subtitle != "";
                                wrap: word-wrap;
                            }

                            for line in root.simulation-info-lines: Text {
                                text: line.text;
                                color: #4b5563;
                                wrap: word-wrap;
                            }
                        }
                    }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }
            }

            Rectangle {
                vertical-stretch: 1;
                border-width: 1px;
                border-color: #d9dde2;
                border-radius: 8px;
                background: #ffffff;

                VerticalBox {
                    padding: 14px;
                    spacing: 10px;

                    HorizontalBox {
                        min-height: 42px;
                        max-height: 42px;
                        spacing: 10px;

                        VerticalBox {
                            spacing: 1px;
                            alignment: start;

                            Text {
                                text: "Simulation";
                                font-size: 19px;
                                font-weight: 700;
                                color: #1f2937;
                            }

                            Text {
                                text: "Workshop cycle preview";
                                color: #5f6b7b;
                                font-size: 12px;
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                        }

                        PrimaryActionButton {
                            title: root.simulation-results-stale ? "Recalculate" : "Calculate Average";
                            attention: root.simulation-results-stale;
                            pressed => { root.run-simulation(); }
                        }
                    }

                    HorizontalBox {
                        spacing: 8px;
                        min-height: 50px;
                        max-height: 50px;

                        SimulationToggleButton {
                            title: "Fletchers";
                            weapon-name: root.fletchers-weapon == "crossbow" ? "Crossbow" : "Bow";
                            icon: root.fletchers-weapon == "crossbow"
                                ? @image-url("../assets/goods/crossbow.png")
                                : @image-url("../assets/goods/bow.png");
                            pressed => { root.toggle-fletchers-weapon(); }
                        }

                        SimulationToggleButton {
                            title: "Poleturners";
                            weapon-name: root.poleturners-weapon == "pike" ? "Pike" : "Spear";
                            icon: root.poleturners-weapon == "pike"
                                ? @image-url("../assets/goods/pike.png")
                                : @image-url("../assets/goods/spear.png");
                            pressed => { root.toggle-poleturners-weapon(); }
                        }

                        SimulationToggleButton {
                            title: "Blacksmiths";
                            weapon-name: root.blacksmiths-weapon == "mace" ? "Mace" : "Sword";
                            icon: root.blacksmiths-weapon == "mace"
                                ? @image-url("../assets/goods/mace.png")
                                : @image-url("../assets/goods/sword.png");
                            pressed => { root.toggle-blacksmiths-weapon(); }
                        }
                    }

                    HorizontalBox {
                        spacing: 10px;
                        min-height: 28px;
                        max-height: 28px;

                        Text {
                            text: "Game Speed";
                            vertical-alignment: center;
                            min-width: 86px;
                            color: #1f2937;
                        }

                        Slider {
                            horizontal-stretch: 1;
                            minimum: 20;
                            maximum: 90;
                            value: root.game-speed;
                            changed(value) => { root.set-game-speed(value); }
                        }

                        Text {
                            text: root.game-speed + " GS";
                            vertical-alignment: center;
                            min-width: 48px;
                            horizontal-alignment: right;
                            color: #1f2937;
                        }
                    }

                    HorizontalBox {
                        spacing: 10px;
                        min-height: 48px;
                        max-height: 48px;

                        Text {
                            text: "Fear Factor";
                            vertical-alignment: center;
                            min-width: 86px;
                            color: #1f2937;
                        }

                        SteppedPopularitySlider {
                            horizontal-stretch: 1;
                            stop-labels: ["0", "-1", "-2", "-3", "-4", "-5"];
                            selected-index: 0 - root.fear-factor;
                            selected(value) => { root.set-fear-factor(0 - value); }
                        }

                        Text {
                            text: root.fear-factor + " FF";
                            vertical-alignment: center;
                            min-width: 48px;
                            horizontal-alignment: right;
                            color: #1f2937;
                        }
                    }

                    VerticalBox {
                        spacing: 6px;
                        min-height: 90px;
                        max-height: 90px;

                        HorizontalBox {
                            spacing: 8px;

                            BuyResourceToggle {
                                title: "Buy Wood";
                                icon: @image-url("../assets/goods/wood.png");
                                checked: root.buy-wood;
                                changed(value) => { root.set-buy-wood(value); }
                            }

                            BuyResourceToggle {
                                title: "Buy Iron";
                                icon: @image-url("../assets/goods/iron.png");
                                checked: root.buy-iron;
                                changed(value) => { root.set-buy-iron(value); }
                            }
                        }

                        HorizontalBox {
                            spacing: 8px;

                            BuyResourceToggle {
                                title: "Buy Wheat";
                                icon: @image-url("../assets/goods/wheat.png");
                                checked: root.buy-wheat;
                                changed(value) => { root.set-buy-wheat(value); }
                            }

                            BuyResourceToggle {
                                title: "Buy Flour";
                                icon: @image-url("../assets/goods/flour.png");
                                checked: root.buy-flour;
                                changed(value) => { root.set-buy-flour(value); }
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        background: transparent;
                    }
                }
            }
        }
    }

    info-panel := Rectangle {
        x: map-panel.x + map-panel.width + root.panel-gap;
        y: root.workspace-top;
        width: root.info-panel-width;
        height: root.height - root.workspace-top - root.outer-padding;
        border-width: 1px;
        border-color: #c5c5c5;
        border-radius: 8px;
        background: #ffffff;

        VerticalBox {
            padding: 10px;
            spacing: 8px;

            Text {
                text: "Settings & Economy";
                font-size: 20px;
                font-weight: 700;
                color: #1f2937;
            }

            CheckBox {
                min-height: 24px;
                max-height: 24px;
                checked <=> root.show-entry-points;
                text: "Show building entry points";
            }

            CheckBox {
                min-height: 24px;
                max-height: 24px;
                checked: root.simulation-tooltips-enabled;
                text: "Show simulation tooltips";
                toggled => { root.set-simulation-tooltips-enabled(self.checked); }
            }

            CheckBox {
                min-height: 24px;
                max-height: 24px;
                checked: root.optimize-fletcher-routing;
                text: "Optimize Fletcher routing";
                toggled => { root.set-optimize-fletcher-routing(self.checked); }
            }

            CheckBox {
                min-height: 24px;
                max-height: 24px;
                checked: root.population-economy-enabled;
                text: "Count population economy";
                toggled => { root.set-population-economy-enabled(self.checked); }
            }

            VerticalBox {
                vertical-stretch: 1;
                spacing: 6px;

                    Rectangle {
                        min-height: 1px;
                        max-height: 1px;
                        background: #d3d9e2;
                    }

                    Text {
                        text: "Additional resources";
                        font-size: 15px;
                        font-weight: 700;
                        color: #1f2937;
                    }

                    NumberSetting {
                        title: "Stone quarries + oxen";
                        value: root.stone-quarry-count;
                        submitted(text) => { root.set-stone-quarry-count(text); }
                    }

                    NumberSetting {
                        title: "Iron mines (requires Iron Stock)";
                        value: root.iron-mine-count;
                        submitted(text) => { root.set-iron-mine-count(text); }
                    }

                    Text {
                        text: "Population, inns, food & tax";
                        font-size: 15px;
                        font-weight: 700;
                        color: root.population-economy-enabled ? #1f2937 : #9ca3af;
                    }

                    NumberSetting {
                        title: "Inns";
                        value: root.inn-count;
                        control-enabled: root.population-economy-enabled;
                        submitted(text) => { root.set-inn-count(text); }
                    }

                    NumberSetting {
                        title: "Population slider maximum";
                        value: root.population-max;
                        control-enabled: root.population-economy-enabled;
                        submitted(text) => { root.set-max-population(text); }
                    }

                    Text {
                        text: "Population: " + root.population-current + " / " + root.population-max
                            + " | workers: " + root.population-workers;
                        color: root.population-economy-enabled ? #374151 : #9ca3af;
                        font-size: 11px;
                    }

                    Slider {
                        enabled: root.population-economy-enabled;
                        opacity: root.population-economy-enabled ? 1 : 0.42;
                        minimum: 0;
                        maximum: max(1, root.population-max);
                        value: root.population-current;
                        changed(value) => { root.set-population(value); }
                    }

                    Text {
                        text: "Tax";
                        font-weight: 700;
                        color: root.population-economy-enabled ? #374151 : #9ca3af;
                    }

                    SteppedPopularitySlider {
                        stop-labels: ["+7", "+5", "+3", "+1", "-2", "-4", "-6", "-8", "-12", "-16", "-20", "-24"];
                        selected-index: root.tax-index;
                        control-enabled: root.population-economy-enabled;
                        selected(value) => { root.set-tax-index(value); }
                    }

                    Text {
                        text: root.tax-label;
                        color: root.population-economy-enabled ? #475569 : #9ca3af;
                        font-size: 11px;
                    }

                    Text {
                        text: "Food ratio";
                        font-weight: 700;
                        color: root.population-economy-enabled ? #374151 : #9ca3af;
                    }

                    SteppedPopularitySlider {
                        stop-labels: ["-8", "-4", "0", "+4", "+8"];
                        selected-index: root.food-ratio-index;
                        control-enabled: root.population-economy-enabled;
                        selected(value) => { root.set-food-ratio-index(value); }
                    }

                    Text {
                        text: root.food-ratio-label;
                        color: root.population-economy-enabled ? #475569 : #9ca3af;
                        font-size: 11px;
                    }

                    Rectangle {
                        min-height: 54px;
                        max-height: 54px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.population-economy-enabled
                            ? (root.popularity-good ? #16a34a : #dc2626)
                            : #d1d5db;
                        background: root.population-economy-enabled
                            ? (root.popularity-good ? #dcfce7 : #fee2e2)
                            : #f3f4f6;

                        Text {
                            width: 100%;
                            height: 100%;
                            text: root.population-economy-enabled
                                ? "Total popularity: " + (root.total-popularity >= 0 ? "+" : "") + root.total-popularity
                                : "Population economy not counted";
                            color: root.population-economy-enabled
                                ? (root.popularity-good ? #166534 : #991b1b)
                                : #6b7280;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "Complete economy report";
                        font-size: 15px;
                        font-weight: 700;
                        color: #1f2937;
                    }

                    TextEdit {
                        vertical-stretch: 1;
                        min-height: 150px;
                        text: root.population-economy-summary;
                        read-only: true;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
            }
        }
    }

    population-panel := Rectangle {
        x: root.outer-padding;
        y: root.workspace-top;
        width: root.width - (root.outer-padding * 2);
        height: root.height - root.workspace-top - root.outer-padding;
        visible: false;
        border-width: 1px;
        border-color: #c5c5c5;
        border-radius: 8px;
        background: #ffffff;

        VerticalBox {
            padding: 16px;
            spacing: 12px;

            Text {
                text: "Population & Economy Calculator";
                font-size: 24px;
                font-weight: 700;
                color: #1f2937;
                min-height: 32px;
                max-height: 32px;
            }

            Text {
                text: "Additional calculation using the current layout, production settings, and fear factor";
                color: #64748b;
                min-height: 22px;
                max-height: 22px;
            }

            HorizontalBox {
                spacing: 12px;
                vertical-stretch: 1;

                Rectangle {
                    horizontal-stretch: 1;
                    border-width: 1px;
                    border-color: #d3d9e2;
                    border-radius: 8px;
                    background: #f8fafc;

                    VerticalBox {
                        padding: 14px;
                        spacing: 10px;

                        Text {
                            text: "Population & policy";
                            font-size: 18px;
                            font-weight: 700;
                            color: #1f2937;
                            min-height: 24px;
                            max-height: 24px;
                        }

                        NumberSetting {
                            title: "Population slider maximum";
                            value: root.population-max;
                            submitted(text) => { root.set-max-population(text); }
                        }

                        Text {
                            text: "Current population: " + root.population-current + " / " + root.population-max;
                            color: #1f2937;
                            min-height: 20px;
                            max-height: 20px;
                        }

                        Rectangle {
                            min-height: 50px;
                            max-height: 50px;
                            background: transparent;

                            Slider {
                                x: 0px;
                                y: 12px;
                                width: parent.width;
                                height: 34px;
                                minimum: 0;
                                maximum: max(1, root.population-max);
                                value: root.population-current;
                                changed(value) => { root.set-population(value); }
                            }

                            Rectangle {
                                x: min(
                                    parent.width - 3px,
                                    (root.population-workers * 1.0 / max(1, root.population-max)) * parent.width,
                                );
                                y: 1px;
                                width: 3px;
                                height: 15px;
                                background: #dc2626;
                            }
                        }

                        Text {
                            text: "Red marker: " + root.population-workers + " workers required by the economy";
                            color: #64748b;
                            font-size: 11px;
                            min-height: 18px;
                            max-height: 18px;
                            wrap: word-wrap;
                        }

                        Text {
                            text: "Tax";
                            font-weight: 700;
                            color: #1f2937;
                            min-height: 20px;
                            max-height: 20px;
                        }

                        SteppedPopularitySlider {
                            stop-labels: ["+7", "+5", "+3", "+1", "-2", "-4", "-6", "-8", "-12", "-16", "-20", "-24"];
                            selected-index: root.tax-index;
                            selected(value) => { root.set-tax-index(value); }
                        }

                        Text {
                            text: root.tax-label;
                            color: #374151;
                            min-height: 20px;
                            max-height: 20px;
                        }

                        Text {
                            text: "Food ratio";
                            font-weight: 700;
                            color: #1f2937;
                            min-height: 20px;
                            max-height: 20px;
                        }

                        SteppedPopularitySlider {
                            stop-labels: ["-8", "-4", "0", "+4", "+8"];
                            selected-index: root.food-ratio-index;
                            selected(value) => { root.set-food-ratio-index(value); }
                        }

                        Text {
                            text: root.food-ratio-label;
                            color: #374151;
                            min-height: 20px;
                            max-height: 20px;
                        }

                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    border-width: 1px;
                    border-color: #d3d9e2;
                    border-radius: 8px;
                    background: #f8fafc;

                    VerticalBox {
                        padding: 14px;
                        spacing: 10px;

                        Text {
                            text: "Additional buildings";
                            font-size: 18px;
                            font-weight: 700;
                            color: #1f2937;
                            min-height: 24px;
                            max-height: 24px;
                        }

                        NumberSetting {
                            title: "Inns (20 wood + 100 gold, 1 worker each)";
                            value: root.inn-count;
                            submitted(text) => { root.set-inn-count(text); }
                        }

                        NumberSetting {
                            title: "Stone quarries + oxen (25 wood, 4 workers each)";
                            value: root.stone-quarry-count;
                            submitted(text) => { root.set-stone-quarry-count(text); }
                        }

                        NumberSetting {
                            title: "Iron mines (20 wood, 2 workers each)";
                            value: root.iron-mine-count;
                            submitted(text) => { root.set-iron-mine-count(text); }
                        }

                        Text {
                            text: "Press Enter after editing a building count.";
                            color: #64748b;
                            font-size: 11px;
                            min-height: 18px;
                            max-height: 18px;
                        }

                        TextEdit {
                            vertical-stretch: 1;
                            text: root.population-worker-summary;
                            read-only: true;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    border-width: 1px;
                    border-color: #d3d9e2;
                    border-radius: 8px;
                    background: #f8fafc;

                    VerticalBox {
                        padding: 14px;
                        spacing: 10px;

                        Rectangle {
                            min-height: 78px;
                            max-height: 78px;
                            border-radius: 8px;
                            background: root.popularity-good ? #dcfce7 : #fee2e2;
                            border-width: 1px;
                            border-color: root.popularity-good ? #16a34a : #dc2626;

                            Text {
                                width: 100%;
                                height: 100%;
                                text: "Total popularity: " + (root.total-popularity >= 0 ? "+" : "") + root.total-popularity;
                                color: root.popularity-good ? #166534 : #991b1b;
                                font-size: 22px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        TextEdit {
                            vertical-stretch: 1;
                            text: root.population-economy-summary;
                            read-only: true;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
}
